// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Video {
  id             String   @id @default(uuid())
  userId         String
  title          String
  description    String?
  publicId       String
  originalsize    String @map("originalSize")
  compressedsize   String @map("compressedSize")
  duration       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("videos")
}
